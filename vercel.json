{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "flask",
      "functions": {
        "app.py": {
          "includeFiles": "templates/**,static/**"
        },
        "**/*.py": {
          "includeFiles": "templates/**,static/**"
        },
        "**": {
          "includeFiles": "templates/**,static/**"
        }
      }
    },
    "sk": {
      "root": "SK",
      "framework": "flask",
      "functions": {
        "app.py": {
          "includeFiles": "templates/**,static/**"
        },
        "**/*.py": {
          "includeFiles": "templates/**,static/**"
        },
        "**": {
          "includeFiles": "templates/**,static/**"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
