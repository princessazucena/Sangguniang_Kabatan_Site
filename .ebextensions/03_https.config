# Open TCP/443 on the EC2 security group so HTTPS traffic can reach
# nginx. The Let's Encrypt cert + nginx config are wired up by the
# postdeploy hook at .platform/hooks/postdeploy/01_letsencrypt.sh.
Resources:
  sslSecurityGroupIngress:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId: {"Fn::GetAtt" : ["AWSEBSecurityGroup", "GroupId"]}
      IpProtocol: tcp
      FromPort: 443
      ToPort:   443
      CidrIp:   0.0.0.0/0
